{
  "name": "openclaw-claude-code",
  "version": "1.0.0",
  "description": "OpenClaw plugin — routes all inference through your local Claude Code / Cowork install. No API key. No direct Anthropic calls. Uses your existing subscription.",
  "keywords": ["openclaw", "openclaw-plugin", "claude", "claude-code", "cowork"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
